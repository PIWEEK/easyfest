{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "activities_staff": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::activity.activity",
      "mappedBy": "staff"
    },
    "dni": {
      "type": "string"
    },
    "phone_number": {
      "type": "biginteger"
    },
    "surname": {
      "type": "string"
    },
    "pseudonym": {
      "type": "string"
    },
    "smial": {
      "type": "string"
    },
    "room_code": {
      "type": "string"
    },
    "menu_adds": {
      "type": "string"
    },
    "mentor": {
      "type": "boolean"
    },
    "minor": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "room_type": {
      "type": "enumeration",
      "enum": [
        "Individual",
        "Doble",
        "Triple",
        "Aleatoria Doble",
        "Aleatoria Triple"
      ]
    },
    "activities_registered": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::activity.activity",
      "mappedBy": "registered_users"
    },
    "activities_queued": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::activity.activity",
      "mappedBy": "queued_users"
    },
    "registration": {
      "type": "enumeration",
      "enum": [
        "completa",
        "parcial",
        "aleatoria"
      ]
    },
    "cond_random": {
      "type": "string"
    },
    "mentee": {
      "type": "enumeration",
      "enum": [
        "Sí",
        "No",
        "Sí, pero"
      ]
    },
    "age": {
      "type": "enumeration",
      "enum": [
        "Adulto",
        "Menor"
      ]
    },
    "minor_adds": {
      "type": "string"
    },
    "menu": {
      "type": "string"
    },
    "allergy": {
      "type": "string"
    },
    "late_arrival": {
      "type": "string"
    },
    "pre_exit": {
      "type": "string"
    },
    "gala_dinner": {
      "type": "string"
    },
    "all_inclusive": {
      "type": "boolean"
    },
    "song_book": {
      "type": "string"
    },
    "supplement": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "shirt": {
      "type": "string"
    },
    "aide": {
      "type": "enumeration",
      "enum": [
        "No",
        "General",
        "Audiovisuales",
        "Cualquier tipo",
        "Apoyo Técnico"
      ]
    }
  }
}
